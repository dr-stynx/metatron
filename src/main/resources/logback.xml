<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="studio.phaseshift.metatron.ui.GraphittyLogger"/>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="cch.qos.logback" level="WARN">
        <appender-ref ref="STDOUT" />
    </logger>
</configuration>