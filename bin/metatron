#!/bin/sh

set -e

java -Dlogback.configurationFile=conf/logback.xml \
    --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED \
    --enable-native-access=ALL-UNNAMED \
    --enable-native-access=com.fazecast.jSerialComm
    -cp target/metatron-0.1-SNAPSHOT-jar-with-dependencies.jar \
        studio.phaseshift.metatron.BootLoader "$@"
