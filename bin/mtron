#!/bin/sh

set -e

command=$1

boot_args=$(cat << EOF
[host    => <ws://127.0.0.1:8887>,
 cluster => <ws://localhost:8888>,
 boot    => <boot/mtronsh.mtron>,
 log     => error,
 command => $command]
EOF
)

java -Dlogback.configurationFile=conf/logback.xml \
    --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED \
    --enable-native-access=ALL-UNNAMED \
    -cp target/metatron-0.1-SNAPSHOT-jar-with-dependencies.jar \
        studio.phaseshift.metatron.BootLoader "$boot_args"

