[== mount instruction sets ==]
print("{{y}}mounting instruction sets\n{{X}}");
import(/m/mach/io);
import(/m/web);
import(/m/iot);
import(/m/iot/haos);
import(/m/iot/miot);
import(/m/grph);
import(/m/grph/tp3);
  mem::[pattern => /usr/#,                                 
        q       => [subq::[=>]]]@/sys/space/usr;
  mem::[pattern => /shared/#]@/sys/space/shared;