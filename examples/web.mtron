/sys/lang/kv   -> */kv;
/sys/lang/web  -> */web;
/sys/lang/grph -> */grph;
/sys/lang/vec  -> */vec;
/sys/lang/ach  -> */mach;
/sys/lang/llm  -> */llm;
---
/sys/space/usr    -> kv::[pattern     => /usr/#];
/sys/space/shared -> kv::[pattern     => /shared/#].@/sys/space/shared;
/sys/space/ollama -> ollama::[host    => <http://localhost:11434>,
                              pattern => /ollama/#];
web::[host       => <http://localhost:8777>,
      pattern    => <http://#>,
      route      => [/     => examples/www,
                     /docs => target/docs ]].@/sys/space/web
