/sys/lang/m/kv   -> */mkv;
/sys/lang/m/web  -> */mweb;
/sys/lang/m/grph -> */mgrph;
/sys/lang/m/vec  -> */mvec;
/sys/lang/m/ach  -> */mach;
/sys/lang/m/llm  -> */mllm;
---
kv::[pattern     => /usr/#].@/sys/space/usr;
kv::[pattern     => /shared/#].@/sys/space/shared;
ollama::[host    => <http://localhost:11434>,
                     pattern => /ollama/#].@/mnt/ollama;
web::[host       => <http://localhost:8777>,
      pattern    => <http://#>,
      route      => [/     => examples/www,
                     /docs => target/docs ]].@/sys/space/web
