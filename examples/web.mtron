mkv(pattern     => /usr/#).@/mnt/usr;
mkv(pattern     => /shared/#).@/mnt/shared;
mollama(host    => <http://localhost:11434>,
        pattern => /ollama/#).@/mnt/ollama;
mweb(host       => <http://localhost:8777>,
     pattern    => <http://#>,
     route      => [
           /    => examples/www,
       /docs    => target/docs]).@/mnt/web
