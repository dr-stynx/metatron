[-- metatron example boot --];
[-- mount instruction sets --];
/sys/router/lang/sys   -> */sys;
/sys/router/lang/kv    -> */kv;
/sys/router/lang/web   -> */web;
/sys/router/lang/grph  -> */grph;
/sys/router/lang/vec   -> */vec;
/sys/router/lang/mach  -> */mach;
/sys/router/lang/llm   -> */llm;
/sys/router/lang/clstr -> */clstr;
[-- mount spaces --];
    kv::[pattern => </usr/#>]@/sys/router/space/usr;
    kv::[pattern => /shared/#]@/sys/router/space/shared;
    web::[host   => <http://localhost:8777>,
         pattern => <http://#>,
         route   => [/     => examples/www,
                     /docs => target/docs ]]@/sys/router/space/web;
ollama::[host    => <http://localhost:11434>,
         pattern => /ollama/#]@/sys/router/space/ollama;
  grph::[pattern => /g/#,
         space   => kv::[pattern => /g/#],
         load    => <tinkerpop-modern>]@/sys/router/space/tp3;
 clstr::[pattern => <ws://#>]@/sys/router/space/clstr;
  mqtt::[pattern => /mqtt/zigbee2mqtt/#,
         host    => <mqtt://chibi.local:1883>,
         prefix  => </mqtt/>]@/sys/router/space/mqtt;
 *boot/option/mode.-<|[?=server   => print('\n\t{{g}}-<{{c}}server mode{{g}}>-{{X}}'), 
                        ?=console => print('\n\t{{g}}-<{{c}}client mode{{g}}>-{{X}}'), 
                        _         => print(_,'\n\t')];
 *boot/option.print(_)


