[-- metatron example boot --];
print("{{r}}------------\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{r}}------------{{X}}\n");
[-- mount instruction sets --];
/sys/mod/sys   -> */sys;
/sys/mod/fs    -> */fs;
/sys/mod/kv    -> */kv;
/sys/mod/web   -> */web;
/sys/mod/iot   -> */iot;
/sys/mod/grph  -> */grph;
/sys/mod/vec   -> */vec;
/sys/mod/mach  -> */mach;
/sys/mod/llm   -> */llm;
[-- mount spaces --];
     kv::[pattern => /usr/#]@/sys/space/usr;
     kv::[pattern => /shared/#]@/sys/space/shared;
    web::[host    => <http://localhost:8777>,
          pattern => http://#,
          route   => [/     => examples/www,
                      /docs => target/docs ]]@/sys/space/web;
   grph::[pattern => /g/#,
          store   => kv::[pattern => /g/#],
          :load   => grateful]@/sys/space/tp3;
   mqtt::[pattern => /mqtt/#,
          host    => <mqtt://chibi.local:1883>,
          prefix  => /mqtt/]@/sys/space/mqtt;
    mqtt::[pattern  => /zigbee2mqtt/#,
             host   => <mqtt://chibi.local:1883>,
             prefix => <>]@/sys/space/zigbee2mqtt;
     fs::[pattern => /home/#]@/sys/space/fs;
     kv::[pattern => /usr/ai/#]@/sys/space/ai;
     /usr/ai/ollama -> ollama::[host => <http://localhost:11434>, model => |load()];
console::[        => ];
 [-- *boot/args/mode.-<|[?=server   => print('\n\t{{g}}-<{{c}}server mode{{g}}>-{{X}}'), 
 [--                       ?=console => print('\n\t{{g}}-<{{c}}client mode{{g}}>-{{X}}').map(console::[=>]), 
 [--                      _         => print(_,'\n\t')];
 [--*boot/args.print(_)

 

