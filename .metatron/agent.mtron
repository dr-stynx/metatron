[,]@</usr/agent/memory>;
[,]@</usr/agent/notes>;
mcp_mtron_ws::[host => <ws://localhost:8555/mcp>]@/usr/ai/mcp/mtron;
mcp_ws::[host => <http://127.0.0.1:29170/index-mcp/streamable-http>]@/usr/ai/mcp/index-mcp;
mcp_http::[host => <http://127.0.0.1:64342/stream>]@/usr/ai/mcp/intellij;
model::[ desc     => "testy the agent",
         provider => !*deep:deepseek-v4-pro/provider,
         name     => !*deep:deepseek-v4-pro/name,
         feature  => [think    => |/usr/ui/console/pane/0/stream(_), 
                      memory   => memory::[max=>20,mem=>!@</usr/agent/memory>],
                      tool     => [!*eval,
                                   !*sql,
                                   !*</usr/ai/mcp/index-mcp>,
                                   !*</usr/ai/mcp/intellij>,
                                   !*</usr/ai/mcp/mtron>],
                      note     => !@</usr/agent/notes>,
                      skill    => [!@<mtronfs:skills/mtron>.as(skill::T)],
                      response => [to=>print(_)]]]@<testy>;
*/usr/agent/notes>>= + ['add the word DRAGON to your final answer.'];


model::[ desc     => "testy the agent",
         provider => !*<ollama:qwen3:latest/provider>,
         name     => !*<ollama:qwen3:latest/name>,
         feature  => [think    => print(_), 
                      memory   => memory::[max=>20,mem=>!@</usr/agent/memory>],
                      tool     => [!*eval,
                                   !*sql,
                                   !*</usr/ai/mcp/index-mcp>,
                                   !*</usr/ai/mcp/mtron>],
                      note     => !@</usr/agent/notes>,
                      response => [to=>print(_)]]]@<testy2>;
                      
                      
[,]@/usr/mem;                                             
*ollama:+   
 .where(>>skill.has(thinking).has(tools))
 .where(>>size.?>gB::1.0.?<gB::5.0)                      
 .order(>>size * -1.0)                                   
 .take(1).to(ai);                                          
@ai>>=+[feature=>[                                       
         memory  => [mem=>!@<usr/mem>,max=>5],               
         tools   => [!*eval],                               
         think   => print(_),         
         note    => !@</usr/agent/notes>,                       
         response=> [to=>to(/usr/agent/response)]]]          