[== metatron example boot ==];
print("""
{{y}} ____    ___    ___   ______    ___ ___  ______  ____    ___   ____  
|    \  /   \  /   \ |      |  |   T   T|      ||    \  /   \ |    \ 
|  o  )(     YY     )|      |  | _   _ ||      ||  D  )(     )|  _  )
|     T|  O  ||  O  |l_j  l_j {{g}} |  \_/  |l_j  l_j|    / |  O  ||  |  |
|  O  ||     ||     |  |  | __ |   |   |  |  |  |    \ |     ||  |  |
|     |l     !l     !  |  ||  T|   |   |  |  |  |  .  \l    {{b}} !|  |  |
l_____j \___/  \___/   l__jl__jl___j___j  l__j  l__j\_j \___/ l__j__j                                                                     
""")
print("{{r}}------------\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{r}}------------{{X}}\n");
[== mount instruction sets ==]
print("{{y}}mounting instruction sets\n{{X}}");
import(/m/mach/io);
import(/m/math,math:);
import(/m/web,web:);
import(/m/iot);
import(/m/iot/haos);
import(/m/iot/miot);
import(/m/grph);
import(/m/llm);
import(/m/tble);
import(/m/dcmnt);
[== global settings store in boot ==]
print("{{y}}mqtt broker location{{X}}: ", <boot/args/mqtt>.else(boot/args/mqtt -> [broker => <mqtt://chibi.local:1883>]),"\n");
print("{{y}}cluster peers{{X}}: ", *<boot/peers>.else(boot/peers -> [ws://localhost:6666,<ws://127.0.0.1:7777>]),"\n");
print("{{y}}supported scripting environments:\n{{X}}", *<boot/script>.else(boot/script -> 
 [sh     => /bin/sh,
  bash   => /bin/bash, 
  zsh    => /bin/zsh, 
  python => /usr/bin/python3,
  perl   => /usr/bin/perl,
  mtron  => /bin/mtron]),"\n");
[== mount computing spaces ==];
 mem::[pattern   => /usr/#,                                 
       q         => [subq::[=>]]]@/sys/space/usr;
 mem::[pattern   => /shared/#,
       persist   => </tmp/shared.mtron>]@/sys/space/shared;
 [==meta::[pattern  => </a/cluster/#>,
        host     => <ws://localhost:6666>,
        route    => [</a/cluster>=></shared>],
        peers    => !*boot/peers]@/sys/space/meta1;
 meta::[pattern  => </b/cluster/#>,
        host     => <ws://127.0.0.1:7777>,
        route    => [</b/cluster>=></shared>],
        peers    => !*boot/peers]@/sys/space/meta2;==]
 http::[host     => <http://localhost:8777>,
        pattern  => http://#,
        route    => [/     => examples/www,
                     /docs => target/docs ]]@/sys/space/www;
  graphdb::[pattern  => /h/#,
        route    => [</h/+/>=><>],
        native   => [factory  => mfactory::[=>],
                     load     => grateful]]@/sys/space/grateful;                    
  graphdb::[pattern  => g:#,
        route    => [<g:V>=><V>,
                     <g:E>=><E>,
                     <g:S>=>/m/grph/schema/modern],
        native   => [factory  => mfactory::[=>],
                     load     => modern]]@/sys/space/modern;
  mqtt::[pattern => <mqtt:#>,
         host    => !*boot/args/mqtt/broker,
         route   => [mqtt:=><>]]@/sys/space/mqtt;
  miot::[pattern    => <mtron:#>,
         host       => !*boot/args/mqtt/broker,
         serializer => !*</m/mach/io/serializer/json/simple>,
         route      => [mtron:=>metatron/]]@/sys/space/mqtt/metatron;
  mqtt::[pattern    => <z2m:#>,
         host       => !*boot/args/mqtt/broker,
         serializer => !*</m/mach/io/serializer/json/simple>,
         route      => [z2m:=>zigbee2mqtt/]]@/sys/space/mqtt/zigbee2mqtt;
  haos::[pattern       => <ha:#>,
         host          => !*boot/args/mqtt/broker,
         serializer    => !*</m/mach/io/serializer/json/simple>,
         command_topic => inst?uri<=rec(){ to(a).map(z2m:).mult(*a>>friendly_name).mult(set/state) },
         route         => [ha:=>homeassistant/]]@/sys/space/mqtt/homeassistant;
    fs_prefix     -> *boot/args/local.as(str::T).plus(':#').as(uri::T);
    fs::[pattern  => local:#,
          [--route   => [!*fs_prefix=><~/>],--]
          route   => [local:=><~/>],
          script  => !*boot/script]@/sys/space/fs;
 serial::[pattern => <serial:#>,
          route   => [serial:=><>]]@/sys/space/serial;
 catalog::[host    => <http://localhost:11434>,
           pattern => <ollama:#>,
           name    => <ollama>,
           route   => [ollama:=><>]]@/sys/space/ollama;
 catalog::[host    => <https://api.openai.com/v1>,
           organization => !*</sys/env/OPENAI_ORG_ID>,
           api_key => !*</sys/env/OPENAI_API_KEY>,
           pattern => <openai:#>,
           name    => <openai>,
           route   => [<openai:>=><>]]@/sys/space/openai;
 *<local:software/metatron/.agent/skills/mtron-assistance>.as(skill::T).to(/usr/ai/skills/mtron-assistance);
 tabledb::[pattern    => netflix:#,
        host       => <mariadb://localhost:3306/netflix?user=mtron&password=mtron>,
        route      => [<netflix:>=><>],
        serializer => !*</m/mach/io/serializer/json/simple>,
        table      => [,],
        driver     => <org.mariadb.jdbc.Driver>]@/sys/space/netflix;
 tabledb::[pattern    => acme:#,
        host       => <mariadb://localhost:3306/classicmodels?user=mtron&password=mtron>,
        route      => [<acme:>=><>],
        serializer => !*</m/mach/io/serializer/string/clean>,
        table      => [,],
        driver     => <org.mariadb.jdbc.Driver>]@/sys/space/acme;
 tabledb::[pattern    => db:#,
        host       => <mariadb://localhost:3306/tble_space?user=mtron&password=mtron>,
        route      => [db:=><>],
        driver     => <org.mariadb.jdbc.Driver>]@/sys/space/db;
 docdb::[pattern     => mongo:#,
       host        => <mongodb://localhost:27017/mflix>,
       serializer  => !*</m/mach/io/serializer/bson>,
       collection  => [,],
       route       => [mongo:=><>]]@/sys/space/mongo;
 mcp::[host      => <ws://localhost:8999>]@/usr/ai/mcp/mtron;
 mcp::[host      => <http://127.0.0.1:29170/index-mcp/streamable-http>]@/usr/ai/mcp/intellij;
 [==mcp::[host      => <http://192.168.88.231:3721/mcp>,
             transport => <streamable-http>,
             headers   => [authorization => "Bearer yFCufT0BTOHuvnmXod8sissMvzIMsmAlsKBtkEb/0j0="]]@/usr/ai/mcp/openclaw;==]
                       
[== load user console ==]
console::[        => ]@/sys/console;
*boot/args.print(_)

 

