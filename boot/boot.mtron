[-- metatron example boot --];
print("""
{{y}} ____    ___    ___   ______    ___ ___  ______  ____    ___   ____  
|    \  /   \  /   \ |      |  |   T   T|      ||    \  /   \ |    \ 
|  o  )(     YY     )|      |  | _   _ ||      ||  D  )(     )|  _  )
|     T|  O  ||  O  |l_j  l_j {{g}} |  \_/  |l_j  l_j|    / |  O  ||  |  |
|  O  ||     ||     |  |  | __ |   |   |  |  |  |    \ |     ||  |  |
|     |l     !l     !  |  ||  T|   |   |  |  |  |  .  \l    {{b}} !|  |  |
l_____j \___/  \___/   l__jl__jl___j___j  l__j  l__j\_j \___/ l__j__j                                                                     
""")
print("{{r}}------------\n{{g}}*{{y}}boot/args{{X}}: ",
      *boot/args, 
     "\n{{r}}------------{{X}}\n");
[== mount instruction sets ==];
print("{{y}}mounting instruction sets\n{{X}}");
import(/mtron/web);
import(/mtron/iot);
import(/mtron/grph);
*<boot/args/mqtt>.else(boot/args/mqtt -> [broker => <mqtt://chibi.local:1883>]).print(_," mqtt broker\n");
*<boot/peers>.else(boot/peers -> [ws://localhost:6666,<ws://127.0.0.1:7777>]).print(_," peers\n");
*<boot/script>.else(boot/script ->
 [sh     => /bin/sh,
  bash   => /bin/bash, 
  zsh    => /bin/zsh, 
  python => /usr/bin/python3,
  perl   => /usr/bin/perl,
  mtron  => /bin/mtron]).print(_," script\n");
[-- mount spaces --];
   mem::[pattern => /usr/#,
         q       => [subq::[=>]]]@/sys/space/usr;
   mem::[pattern => /shared/#,
         persist => </tmp/shared.mtron>]@/sys/space/shared;
  meta::[pattern => </a/cluster/#>,
        host     => <ws://localhost:6666>,
        rewrite  => (</a/cluster>=></shared>),
        peers    => !*boot/peers]@/sys/space/meta1;
 meta::[pattern  => </b/cluster/#>,
        host     => <ws://127.0.0.1:7777>,
        rewrite  => (</b/cluster>=></shared>),
        peers    => !*boot/peers]@/sys/space/meta2;
 http::[host     => <http://localhost:8777>,
         pattern => http://#,
         route   => [/     => examples/www,
                     /docs => target/docs ]]@/sys/space/web;
  grph::[pattern => /g/#,
         store   => kv::[pattern => /g/#],
         load    => modern]@/sys/space/tp3;
  mqtt::[pattern => <wall:#>,
         host    => !*boot/args/mqtt/broker,
         rewrite => <wall:>=><walltron/>]@/sys/space/walltron;
  mqtt::[pattern => <play:#>,
         host    => !*boot/args/mqtt/broker,
         rewrite => <play:>=><playtron/>]@/sys/space/playtron;
  mqtt::[pattern => <ha:#>,
         host    => !*boot/args/mqtt/broker,
         rewrite => <ha:>=><homeassistant/>]@/sys/space/homeassistant;
  mqtt::[pattern => <z2m:#>,
         host    => !*boot/args/mqtt/broker,
         rewrite => <z2m:>=><zigbee2mqtt/>]@/sys/space/zigbee2mqtt;
   [==  bt::[pattern => <bt:#>
          rewrite => <bt:>=><>]@/sys/space/bt; ==]
   [==tabl::[pattern => /postgres/#,
          host    => <postgresql://localhost:5432/world>,
          user    => admin,
          pass    => "admin",
          prefix  => </postgres/>]@/sys/space/postgres;==]
     fs::[pattern => <file:#>,
          rewrite => <file:>=><~/>,
          script  => !*boot/script]@/sys/space/fs;
    mem::[pattern => /usr/ai/#]@/sys/space/ai;
 ollama::[host    => <http://localhost:11434>, 
          model   => |load()]@/usr/ai/ollama;
console::[        => ]@/sys/console;
 [-- *boot/args/mode.-<|[?=server   => print('\n\t{{g}}-<{{c}}server mode{{g}}>-{{X}}'), 
 [--                       ?=console => print('\n\t{{g}}-<{{c}}client mode{{g}}>-{{X}}').map(console::[=>]), 
 [--                      _         => print(_,'\n\t')];
 [--*boot/args.print(_)

 

